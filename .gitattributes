# Always store with LF in the repo; let each OS checkout as it prefers
* text=auto eol=lf

# Shell scripts must always be LF (Docker/Linux will execute them)
*.sh text eol=lf

# Python source
*.py text eol=lf

# Config / data files
*.json text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf
*.env* text eol=lf

# Binaries — never touch line endings
*.pt     binary
*.onnx   binary
*.mp4    binary
*.avi    binary
*.db     binary
*.db-shm binary
*.db-wal binary
