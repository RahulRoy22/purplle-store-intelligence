# Copy to .env and adjust as needed
STORE_ID=store_001
API_HOST=0.0.0.0
API_PORT=8000
DB_PATH=/data/store_intelligence.db
LOG_LEVEL=INFO
STALE_FEED_THRESHOLD_MINUTES=10

# Path to POS transactions CSV (organiser-provided or mock).
# Supports both organiser schema (order_id, order_date, order_time, total_amount, qty)
# and mock schema (transaction_id, store_id, timestamp, amount_inr, items_count).
# Leave empty to skip POS loading (conversion_rate will be 0.0).
POS_CSV_PATH=/data/resource/pos_transactions.csv
